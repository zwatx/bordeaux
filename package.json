{
  "name": "bordeaux",
  "version": "0.2.0-beta.24",
  "private": true,
  "productName": "Bordeaux",
  "author": "FRC Team 2468",
  "license": "Apache-2.0",
  "description": "LabVIEW trajectory and autonomous routine authoring for FRC robots.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build && electron dist-electron/electron/main.js",
    "build": "npm run verify:renderer && npm run build:electron",
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "build:electron": "node scripts/clean-electron-build.mjs && tsc -p tsconfig.electron.build.json",
    "benchmark:renderer:browser": "node scripts/benchmark-renderer-browser.mjs",
    "benchmark:planner-beta": "npm run build:electron && node scripts/evaluate-planner-beta.mjs",
    "certify:field": "npm run build:electron && node scripts/certify-field.mjs",
    "test": "npm run verify:license && vitest run",
    "test:benchmark:e2e": "node --test tests/rendererBrowserBenchmark.e2e.mjs",
    "test:benchmark:choreo": "npm run build:electron && node scripts/choreo-adapter-integration.mjs",
    "test:smoke": "npm run build && npm run test:smoke:built",
    "test:smoke:built": "node scripts/electron-smoke.mjs",
    "verify:renderer": "npm run build:renderer && node scripts/verify-renderer.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:license": "node scripts/verify-license.mjs",
    "verify:prerelease": "node scripts/verify-prerelease-version.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit --pretty false && tsc -p tsconfig.electron.json --noEmit --pretty false",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "package:mac:ci": "npm run build && electron-builder --mac --arm64 --x64 --publish never --config.mac.icon=build/icon.icns",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:win:store": "npm run build && node scripts/package-windows-store.mjs",
    "package:linux": "npm run build && electron-builder --linux --x64 --arm64 --publish never",
    "build:labview-catalog": "npm run build:electron && node scripts/build-labview-catalog.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/semver": "^7.8.0",
    "@types/ssh2": "1.15.5",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "4.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.2",
    "vite": "8.3.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "org.frc2468.bordeaux",
    "productName": "Bordeaux",
    "asar": true,
    "npmRebuild": false,
    "electronUpdaterCompatibility": ">=2.16",
    "publish": {
      "provider": "github",
      "owner": "zwatx",
      "repo": "bordeaux",
      "channel": "beta",
      "releaseType": "prerelease"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/*.mts",
      "!**/*.cts",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!node_modules/buildcheck/**/*",
      "!node_modules/cpu-features/**/*",
      "!node_modules/nan/**/*",
      "!node_modules/ssh2/.eslint*",
      "!node_modules/ssh2/SFTP.md",
      "!node_modules/ssh2/install.js",
      "!node_modules/ssh2/util/**/*",
      "!node_modules/js-yaml/dist/**/*",
      "!node_modules/zod/**/*.js",
      "!node_modules/@modelcontextprotocol/core/**/*.mjs",
      "!node_modules/@modelcontextprotocol/server/**/*.mjs"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "extraResources": [
      {
        "from": "resources/labview-inspection",
        "to": "labview-inspection",
        "filter": [
          "*.ps1",
          "CreateCommandWrapper.vi"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "RIGHTS.md",
        "to": "RIGHTS.md"
      },
      {
        "from": "licenses/OFL-1.1.txt",
        "to": "licenses/OFL-1.1.txt"
      },
      {
        "from": "licenses/ssh2-MIT.txt",
        "to": "licenses/ssh2-MIT.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/Bordeaux.icon",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "semver": "7.7.4",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  }
}
